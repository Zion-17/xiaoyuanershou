.page { padding: 20rpx 24rpx 60rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: #666; margin-bottom: 14rpx; }

.img-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-item {
  position: relative; width: 200rpx; height: 200rpx;
  border-radius: 12rpx; overflow: hidden;
}
.img-item .img { width: 100%; height: 100%; }
.img-del {
  position: absolute; top: 0; right: 0;
  width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5);
  color: #fff; text-align: center; line-height: 40rpx; font-size: 28rpx;
  border-radius: 0 12rpx 0 12rpx;
}
.img-add {
  width: 200rpx; height: 200rpx; border-radius: 12rpx;
  background: #F6F7F9; border: 2rpx dashed #ccc;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.img-add .plus { font-size: 50rpx; color: #999; line-height: 1; }

.field { margin-bottom: 24rpx; }
.row2 { display: flex; gap: 20rpx; }
.input {
  background: #F6F7F9; border-radius: 12rpx;
  padding: 22rpx 24rpx; font-size: 30rpx;
  min-height: 76rpx; line-height: 40rpx;
  color: #222;
}
.textarea {
  background: #F6F7F9; border-radius: 12rpx;
  padding: 22rpx 24rpx;
  width: 100%; height: 200rpx; font-size: 30rpx;
  color: #222;
}
.audit-tip { font-size: 24rpx; color: #FF9500; padding: 10rpx 10rpx 20rpx; }
.submit { margin: 10rpx 20rpx; }
