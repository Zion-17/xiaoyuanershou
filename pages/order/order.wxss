.page { padding: 20rpx 24rpx; }
.empty { text-align: center; padding: 160rpx 0; }
.empty .big { font-size: 100rpx; margin-bottom: 20rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.head { margin-bottom: 16rpx; }
.status { font-size: 26rpx; font-weight: 600; }
.st-pending { color: #FF9500; }
.st-done { color: #00B578; }
.st-cancelled { color: #999; }
.goods { display: flex; align-items: center; }
.goods .cover { width: 120rpx; height: 120rpx; margin-right: 16rpx; font-size: 50rpx; border-radius: 12rpx; }
.t { font-size: 26rpx; margin-bottom: 8rpx; }
.foot { margin-top: 20rpx; }
.ops { display: flex; gap: 16rpx; }
.op {
  font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 999rpx;
  border: 2rpx solid #ddd; color: #666;
}
.op.primary { border-color: #00B578; color: #00B578; }
