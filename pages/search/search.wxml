<!--pages/search/search.wxml-->
<view class="page">
  <view class="topbar">
    <view class="search-box">
      <text class="icon">🔍</text>
      <input class="inp" placeholder="搜索商品名称 / 描述" value="{{kw}}" confirm-type="search" bindinput="onKw" bindconfirm="doSearch" focus="{{true}}" />
      <text class="cancel" bindtap="goBack">取消</text>
    </view>
  </view>

  <!-- 分类筛选：自动换行，不横向滚动 -->
  <view class="cat-bar">
    <view class="chip {{cat===''?'on':''}}" bindtap="setCat" data-id="">全部</view>
    <view class="chip {{cat===item.id?'on':''}}" wx:for="{{categories}}" wx:key="id" bindtap="setCat" data-id="{{item.id}}">{{item.emoji}} {{item.name}}</view>
  </view>

  <!-- 筛选 -->
  <view class="filter">
    <picker class="f-item" range="{{priceRanges}}" bindchange="setPrice">
      <view>价格：{{priceLabel}} ▾</view>
    </picker>
    <picker class="f-item" range="{{conditions}}" bindchange="setCond">
      <view>成色：{{condLabel}} ▾</view>
    </picker>
    <view class="f-item" bindtap="toggleSort">排序：{{sortLabel}} ▾</view>
  </view>

  <!-- 结果 -->
  <view class="result-num muted">共 {{list.length}} 件闲置</view>
  <view class="item card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="cover" style="background:linear-gradient(135deg,{{item.grad[0]}},{{item.grad[1]}});">{{item.emoji}}</view>
    <view class="body">
      <view class="ellipsis-2 title">{{item.title}}</view>
      <view class="muted ellipsis-2 desc">{{item.desc}}</view>
      <view class="row">
        <text class="price">{{item.price}}</text>
        <text class="tag">{{item.condition}}</text>
        <text class="tag">{{item.location}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{list.length===0}}">
    <view class="big">🔍</view>
    <view class="muted">没有找到相关闲置，换个关键词试试</view>
  </view>
</view>
