/* pages/account/account.wxss */
.page { padding: 24rpx; overflow-x: hidden; }

.head { display: flex; flex-direction: column; align-items: center; padding: 40rpx 24rpx; margin-bottom: 24rpx; }
.head .avatar {
  width: 160rpx; height: 160rpx; border-radius: 50%; margin-bottom: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 90rpx; background: #F2F3F5; overflow: hidden;
}

.field { margin-bottom: 24rpx; }
.field:last-child { margin-bottom: 0; }
.tip-sm { margin-top: 10rpx; font-size: 22rpx; }

/* 微信头像：头像正下方的文本按钮，一步触发 */
.wechat-line {
  background: transparent; border: none; padding: 0; margin: 12rpx 0 0;
  line-height: 1.6; font-size: 26rpx; font-weight: 400; color: #00B578;
  text-decoration: underline;
}
.wechat-line::after { border: none; }
.label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }
.input {
  width: 100%; box-sizing: border-box;
  height: 88rpx; line-height: 88rpx;
  background: #F7F8FA; border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx; color: #222;
}
.tip { margin-top: 20rpx; }

.save { margin-top: 32rpx; }
.logout { margin-top: 20rpx; }
.danger { text-align: center; color: #FF4D4F; font-size: 26rpx; margin-top: 40rpx; padding: 16rpx; }

/* emoji 二级面板 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 99;
  display: flex; align-items: flex-end;
}
.panel {
  width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.panel-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 8rpx 24rpx;
}
.panel-title { font-size: 30rpx; font-weight: 600; color: #222; }
.panel-close { font-size: 32rpx; color: #BBB; padding: 4rpx 12rpx; }

.emoji-grid { display: flex; flex-wrap: wrap; padding: 4rpx 0; }
.emoji-cell {
  width: 18%; margin: 1%; height: 112rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 54rpx;
  background: linear-gradient(135deg, #F7F9FB, #ECF0F5);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.emoji-cell:active { transform: scale(0.94); }
.emoji-cell.on {
  background: linear-gradient(135deg, #E6F9F0, #CFF3E3);
  box-shadow: 0 0 0 4rpx rgba(0, 181, 120, 0.35);
}
.panel-hint { text-align: center; margin-top: 20rpx; font-size: 22rpx; }
