.page { padding: 20rpx 24rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.goods { display: flex; align-items: center; }
.goods .cover { width: 100rpx; height: 100rpx; margin-right: 16rpx; font-size: 44rpx; border-radius: 12rpx; }
.t { font-size: 26rpx; margin-bottom: 8rpx; }
.label { font-size: 26rpx; color: #666; margin-bottom: 20rpx; }
.stars { text-align: center; padding: 10rpx 0; }
.star { font-size: 64rpx; color: #DDD; margin: 0 8rpx; }
.star.on { color: #FFB400; }
.score-tip { text-align: center; color: #FF9500; font-size: 26rpx; }
.ta {
  width: 100%; height: 200rpx; background: #F6F7F9;
  border-radius: 12rpx; padding: 20rpx; font-size: 28rpx;
}
.submit { margin: 20rpx; }
