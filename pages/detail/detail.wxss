.page { padding-bottom: 140rpx; position: relative; }
.hero {
  height: 460rpx; display: flex; align-items: center; justify-content: center;
  position: relative;
}
.hero-img {
  width: 100%; height: 460rpx; display: block;
}
.hero-emoji { font-size: 220rpx; }
.hero-cat {
  position: absolute; left: 30rpx; top: 30rpx;
  background: rgba(255,255,255,0.8); padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; z-index: 2;
}
.block { margin: 20rpx 24rpx; }
.price-row { display: flex; align-items: baseline; }
.price.big { font-size: 48rpx; }
.origin { color: #bbb; font-size: 24rpx; text-decoration: line-through; margin-left: 14rpx; }
.title { font-size: 32rpx; font-weight: 600; margin: 16rpx 0 12rpx; line-height: 1.4; }
.meta { display: flex; gap: 24rpx; font-size: 22rpx; }
.block-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.desc { font-size: 26rpx; color: #444; line-height: 1.7; }

.seller { display: flex; align-items: center; }
.seller .avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%; background: #F2F3F5;
  text-align: center; line-height: 80rpx; font-size: 40rpx; margin-right: 20rpx;
}
.s-name { font-size: 28rpx; font-weight: 600; }
.chat-link { color: #00B578; font-size: 26rpx; }

.tip { font-size: 24rpx; color: #FF9500; background: #FFF7E6; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; border-top: 1rpx solid #F2F3F5;
}
.icon-btn { width: 110rpx; text-align: center; }
.icon-btn .ico { font-size: 40rpx; display: block; color: #666; }
.icon-btn .lbl { font-size: 20rpx; color: #999; }
.icon-btn .lbl.on { color: #FFB400; }
.bar-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 999rpx; font-size: 30rpx; margin-left: 20rpx; }
.bar-btn.ghost { background: #E6F9F0; color: #00B578; }
.bar-btn.primary { background: #00B578; color: #fff; }
.bar-btn.disabled { background: #E5E6EB; color: #9AA0A6; }
